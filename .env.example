# ==============================================================================
# AQUASPIN REWARDS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values before running the application.
# Do NOT commit your '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Auth)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
# Note: If deploying to Vercel, the Supabase Integration will inject 
# NEXT_PUBLIC_SUPABASE_URL automatically. The app supports both prefixes.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Application Config
# ------------------------------------------------------------------------------
VITE_APP_NAME="AquaSpin Rewards"
VITE_APP_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. Ad Networks (Monetization)
# ------------------------------------------------------------------------------
# Replace with real keys from your ad provider dashboards before production.
VITE_APPLOVIN_SDK_KEY=your-applovin-sdk-key
VITE_ADSENSE_CLIENT_ID=ca-pub-your-publisher-id
VITE_PROPELLERADS_ZONE_ID=your-zone-id

# ------------------------------------------------------------------------------
# 4. Feature Flags
# ------------------------------------------------------------------------------
# Use 'true' or 'false' for toggling specific app behaviors
VITE_MOCK_ADS=true
VITE_ENABLE_GUEST_PLAY=true
VITE_SPIN_COOLDOWN_SECONDS=30

# ------------------------------------------------------------------------------
# 5. Backend Edge Functions (Server-Side ONLY)
# ------------------------------------------------------------------------------
# These variables should NEVER be prefixed with VITE_ or NEXT_PUBLIC_.
# They must remain secret on the server (e.g. Supabase Edge Functions).
PLINKO_SERVER_SECRET=generate-a-secure-random-string-here
STRIPE_SECRET_KEY=sk_test_...
